{
  "name": "Screenshot",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title displayed under the screenshot"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the uploaded screenshot image"
    },
    "description": {
      "type": "string",
      "description": "Optional caption shown beneath the title"
    },
    "display_order": {
      "type": "number",
      "description": "Sort order \u2014 lower numbers appear first",
      "default": 0
    }
  },
  "required": [
    "title",
    "image_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}